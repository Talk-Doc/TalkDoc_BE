# Copy to .env and fill in values as needed. All variables have safe defaults
# in application.yml except GEMINI_API_KEY (only required when using the
# gemini provider / profile). See README.md for details.

# --- Redis ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Server ----------------------------------------------------------------
SERVER_PORT=8080

# --- AI provider (STT / LLM / TTS) -----------------------------------------
# mock | gemini
TALKDOC_AI_PROVIDER=mock

# Google Gemini API key. Required only when TALKDOC_AI_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional Gemini model overrides (defaults shown as comments).
# GEMINI_STT_MODEL=gemini-3.7-flash       # STT 는 lite 보다 3.7-flash 가 정확 (2.5-flash 는 신규 사용자 404, 3.6-flash 는 느리고 일일 한도 작음)
# GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Gemini 3.x thinking 수준. low 권장(1~2초). 비우면 모델 기본(20~30초).
# GEMINI_THINKING_LEVEL=low

# --- Sign-language recognition (TalkDoc_AI, separate Python service) -------
# mock | http
TALKDOC_SIGN_AI_MODE=mock

# Base URL of the TalkDoc_AI HTTP service. Required only when
# TALKDOC_SIGN_AI_MODE=http.
TALKDOC_SIGN_AI_URL=http://localhost:8000

# --- WebSocket ---------------------------------------------------------------
# Comma-separated list of allowed origins, or * for all.
TALKDOC_WS_ORIGINS=*
